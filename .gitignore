node_modules/
.pnpm-store/
dist/
build/
coverage/
.env
*.log
.venv/
__pycache__/
target/
bin/
obj/
.DS_Store
Thumbs.db
site/
labs/*/node_modules/
labs/04-spring-boot/target/
