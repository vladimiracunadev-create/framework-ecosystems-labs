# Dependencias descargadas por las clases. El código de cada implementación se
# versiona; lo que su gestor de paquetes trae, no.
classes/**/vendor/
classes/**/node_modules/
classes/**/target/
classes/**/bin/
classes/**/obj/
# Se ignora el CONTENIDO de los directorios de tiempo de ejecución, no los
# directorios: Laravel exige que existan en disco y sin ellos falla al arrancar.
classes/**/storage/framework/*/*
classes/**/storage/logs/*
classes/**/bootstrap/cache/*
!classes/**/.gitkeep
classes/**/__pycache__/
classes/**/.venv/

# Salidas de compilacion de las clases frontend: el codigo fuente se versiona, lo que el compilador produce, no.
classes/**/compilados/
classes/**/*.compilada.mjs
