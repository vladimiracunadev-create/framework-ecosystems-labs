{
  "framework": "spring-boot",
  "requiere": [
    "java",
    "mvn"
  ],
  "comprobar": [
    "mvn",
    "--version"
  ],
  "preparar": [
    "mvn",
    "-q",
    "-B",
    "package",
    "-DskipTests"
  ],
  "env": {
    "APP_ENTORNO": "pruebas",
    "APP_SECRETO": "clave-de-produccion-nunca-en-el-repo"
  },
  "arrancar": [
    "java",
    "-jar",
    "target/clase-075-1.0.0.jar",
    "--server.port=${PUERTO}"
  ],
  "espera_ms": 60000
}
