<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Los datos congelados se copian junto al binario. `Update` y no
         `Include`: el SDK de .NET ya incluye los .json del proyecto como
         `Content` por omisión, y volver a incluirlos es el error NETSDK1022
         —«Duplicate Content items»— que rompe la compilación. Lo que hace
         falta es cambiarles una propiedad, no añadirlos otra vez. -->
    <Content Update="datos\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
