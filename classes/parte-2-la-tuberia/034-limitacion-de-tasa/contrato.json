{
  "clase": "034",
  "titulo": "Limitación de tasa",
  "descripcion": "Superado el cupo se responde 429 con Retry-After, y se informa del cupo restante.",
  "estado": "construida",
  "tipo": "http",
  "casos": [
    {
      "nombre": "la primera petición pasa",
      "peticion": { "metodo": "GET", "ruta": "/datos" },
      "esperado": { "estado": 200, "json": { "ok": true } }
    },
    {
      "nombre": "la segunda también",
      "peticion": { "metodo": "GET", "ruta": "/datos" },
      "esperado": { "estado": 200 }
    },
    {
      "nombre": "la tercera agota el cupo",
      "peticion": { "metodo": "GET", "ruta": "/datos" },
      "esperado": { "estado": 200 }
    },
    {
      "nombre": "la cuarta responde 429",
      "peticion": { "metodo": "GET", "ruta": "/datos" },
      "esperado": { "estado": 429 }
    },
    {
      "nombre": "el 429 dice cuándo volver",
      "peticion": { "metodo": "GET", "ruta": "/datos" },
      "esperado": { "estado": 429, "cabecera_presente": ["retry-after"] }
    }
  ]
}
