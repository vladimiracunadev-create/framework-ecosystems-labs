{
  "clase": "041",
  "titulo": "Esquemas",
  "descripcion": "Declarar la forma de los datos en lugar de comprobarla a mano, y publicar esa declaración.",
  "estado": "construida",
  "tipo": "http",
  "casos": [
    {
      "nombre": "una tarea que cumple el esquema se crea",
      "peticion": { "metodo": "POST", "ruta": "/tareas", "cuerpo": { "titulo": "válida", "prioridad": 2 } },
      "esperado": { "estado": 201 }
    },
    {
      "nombre": "un campo obligatorio ausente se rechaza",
      "peticion": { "metodo": "POST", "ruta": "/tareas", "cuerpo": { "prioridad": 1 } },
      "esperado": { "estado": 422, "json_contiene": { "errors": [{ "campo": "titulo", "codigo": "REQUERIDO" }] } }
    },
    {
      "nombre": "un valor fuera del conjunto permitido se rechaza",
      "peticion": { "metodo": "POST", "ruta": "/tareas", "cuerpo": { "titulo": "vale", "prioridad": 9 } },
      "esperado": { "estado": 422, "json_contiene": { "errors": [{ "campo": "prioridad", "codigo": "VALOR" }] } }
    },
    {
      "nombre": "un campo que el esquema no declara se rechaza, no se ignora",
      "peticion": { "metodo": "POST", "ruta": "/tareas", "cuerpo": { "titulo": "vale", "titluo": "error de dedo" } },
      "esperado": { "estado": 422 }
    },
    {
      "nombre": "el esquema se publica para que el cliente lo lea",
      "peticion": { "metodo": "GET", "ruta": "/esquemas/tarea" },
      "esperado": { "estado": 200, "json_contiene": { "type": "object" } }
    }
  ]
}
