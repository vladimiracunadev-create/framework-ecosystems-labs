{
  "framework": "laravel",
  "requiere": [
    "php",
    "composer"
  ],
  "comprobar": [
    "composer",
    "--version"
  ],
  "preparar": [
    [
      "composer",
      "install",
      "--no-interaction",
      "--quiet"
    ],
    [
      "php",
      "-r",
      "@unlink(sys_get_temp_dir().'/clase-015-laravel.json');"
    ]
  ],
  "arrancar": [
    "php",
    "-S",
    "127.0.0.1:${PUERTO}",
    "-t",
    "public"
  ],
  "espera_ms": 30000
}