{
  "framework": "rails",
  "requiere": [
    "ruby",
    "bundle"
  ],
  "comprobar": [
    "ruby",
    "--version"
  ],
  "preparar": [
    "bundle",
    "install",
    "--quiet"
  ],
  "arrancar": [
