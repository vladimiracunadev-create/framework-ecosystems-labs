// El esquema en el lenguaje propio de Prisma. De aquí salen el cliente tipado y
// las migraciones — la decisión que la ficha de Prisma discute.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./datos.db"
}

model Tarea {
  id     Int    @id @default(autoincrement())
  titulo String
}
