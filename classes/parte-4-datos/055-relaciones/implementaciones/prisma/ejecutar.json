{
  "framework": "prisma",
  "requiere": [
    "node",
    "pnpm"
  ],
  "comprobar": [
    "pnpm",
    "--version"
  ],
  "preparar": [
    [
      "pnpm",
      "install",
      "--silent",
      "--ignore-scripts"
    ],
    [
      "pnpm",
      "exec",
      "prisma",
      "generate"
    ]
  ],
  "arrancar": [
    "node",
    "server.mjs"
  ],
  "espera_ms": 40000
}