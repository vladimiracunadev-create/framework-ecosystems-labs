{
  "framework": "astro",
  "requiere": ["node", "pnpm"],
  "comprobar": ["pnpm", "--version"],
  "preparar": [
    ["pnpm", "install", "--silent", "--ignore-scripts"],
    ["pnpm", "exec", "astro", "build"]
  ],
  "env": { "HOST": "127.0.0.1" },
  "arrancar": ["node", "./dist/server/entry.mjs"],
  "espera_ms": 60000
}
