---
// La misma pantalla para las dos rutas.
const { como, datos } = Astro.props;
---
<main data-como={como}>
  <h1>Hola, {datos.usuario.nombre}</h1>
  <p data-pedidos={datos.pedidos.length}>{datos.pedidos.length} pedidos</p>
  <ul>
    {datos.avisos.map((aviso) => <li>{aviso}</li>)}
  </ul>
</main>
